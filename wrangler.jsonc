{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "website-dev-portfolio",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "website-dev-portfolio"
		}
	],
	// No R2 incremental cache: every page is static and nothing uses ISR/revalidate
	"images": {
		// next/image optimization via Cloudflare Images (Free plan: 5,000 unique transformations/month)
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
